{
    "name": "robot-council/fleet-kit",
    "description": "Forkable operator tools for a Robot Council fleet: seat-stage stages a machine's seats, seat-pace paces a usage allowance",
    "type": "library",
    "keywords": ["robot-council", "fleet", "claude-code", "tmux", "psmux", "usage", "pacing"],
    "homepage": "https://github.com/robot-council/fleet-kit",
    "license": "MIT",
    "authors": [
        {"name": "Robot Council", "homepage": "https://github.com/robot-council"}
    ],
    "support": {
        "issues": "https://github.com/robot-council/fleet-kit/issues",
        "source": "https://github.com/robot-council/fleet-kit"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.2.1"
    },
    "bin": ["bin/seat-pace", "bin/seat-stage"],
    "autoload": {
        "classmap": ["lib/pace/", "lib/stage/"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
