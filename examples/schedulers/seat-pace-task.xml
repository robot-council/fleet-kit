<?xml version="1.0" encoding="UTF-16"?>
<!-- Task Scheduler: one `seat-pace watch` tick every 55 minutes.
     Replace C:\path\to\fleet-kit, then: schtasks /Create /TN seat-pace /XML seat-pace-task.xml
     `seat-pace read` works on Windows: it reads Claude Code's credential file (docs/pacing.md). Run
     `seat-pace read` once by hand first. The .ps1 wrapper suits a checkout; for a Composer install point the command at the seat-pace
     proxy, and --config at the seats file in your private configuration repository. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT55M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>pwsh</Command>
      <Arguments>-NoProfile -File C:\path\to\fleet-kit\bin\seat-pace.ps1 watch --once --config C:\path\to\fleet-config\seats.toml</Arguments>
    </Exec>
  </Actions>
</Task>
