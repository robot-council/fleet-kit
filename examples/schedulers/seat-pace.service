# systemd user unit: one `seat-pace watch` tick. Pair it with seat-pace.timer.
# For a Composer install, use the seat-pace proxy and the seats.toml in your private configuration repository.
# Copy both to ~/.config/systemd/user/, replace /path/to/fleet-kit, then:
#   systemctl --user enable --now seat-pace.timer
[Unit]
Description=seat-pace: read, log and judge a usage allowance

[Service]
Type=oneshot
# An account that lists a fallback machine also needs `robot-council` on PATH and ROBOT_COUNCIL_SERVICE,
# e.g. Environment=ROBOT_COUNCIL_SERVICE=https://fleet.example.org
ExecStart=/path/to/fleet-kit/bin/seat-pace watch --once --config /path/to/fleet-config/seats.toml
